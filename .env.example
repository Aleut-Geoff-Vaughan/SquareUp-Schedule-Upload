# Square Schedule Manager - Environment Configuration
# Copy this file to .env and fill in your values.

# Flask secret key - REQUIRED. The app refuses to start unless this is set to a
# strong value (>= 32 chars, not a known placeholder). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave this blank in the committed example so an unconfigured deploy fails
# closed instead of running with a public key.
SECRET_KEY=

# Square environment toggle (sandbox | production), default: sandbox.
# Admins can also flip this at runtime from the dashboard.
SQUARE_ENVIRONMENT=sandbox

# Sandbox credentials (used when SQUARE_ENVIRONMENT=sandbox)
SANDBOX_ACCESS_TOKEN=
SANDBOX_APPLICATION_ID=

# Production credentials (used when SQUARE_ENVIRONMENT=production)
PRODUCTION_ACCESS_TOKEN=
PRODUCTION_APPLICATION_ID=

# Legacy single-token fallback (used if SANDBOX_/PRODUCTION_ vars are unset)
SQUARE_ACCESS_TOKEN=

# Database file path (defaults to schedules.db in the working directory)
DB_PATH=data/schedules.db

# Flask environment. Keep this 'production' for any real deployment — setting
# it to 'development' enables the Werkzeug debugger (remote code execution if
# exposed) and is only for local work behind no network.
FLASK_ENV=production

# Set to 0 only when running locally over plain HTTP (no TLS); otherwise leave
# unset so session cookies require HTTPS.
# SESSION_COOKIE_SECURE=1

# Optional: initial admin password on first run. If unset, a random password is
# generated and printed to the logs once.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=

# Optional background automation (0 = disabled). Enable only with a single
# gunicorn worker (GUNICORN_WORKERS=1) so jobs don't run once per worker.
AUTO_SYNC_HOURS=0
AUTO_BACKUP_HOURS=0
BACKUP_DIR=data/backups
BACKUP_RETAIN=14
GUNICORN_WORKERS=2
